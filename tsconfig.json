{
  "extends": "@react-native/typescript-config/tsconfig.json",
  "compilerOptions": {
    "types": ["jest"],
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "paths": {
      "@assets/*": ["src/assets/*"],
      "@features/*": ["src/features/*"],
      "@service/*": ["src/service/*"],
      "@styles/*": ["src/styles/*"],
      "@navigation/*": ["src/navigation/*"],
      "@components/*": ["src/components/*"],
      "@state/*": ["src/state/*"],
      "@utils/*": ["src/utils/*"]
    }
  }
}